# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/activity_monitor
# Hosted: the Neon connection string, e.g.
#         postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
#         Neon requires TLS, so keep sslmode=require. The same string works from a
#         laptop and from the deployed service — there is no internal-only host.
DATABASE_URL=

# Port the HTTP + Socket.io server binds to. Render injects this automatically —
# leave it unset there, or the health check will fail.
PORT=4000

# Comma-separated browser origins allowed to call the REST API and open a socket.
# Exact matches only, so add each Vercel domain you need, e.g.
# http://localhost:3000,https://activity-monitor.vercel.app
CORS_ORIGIN=http://localhost:3000
