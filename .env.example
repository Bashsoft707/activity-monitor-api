# PostgreSQL connection string.
# Local:   postgresql://USER:PASSWORD@localhost:5432/activity_monitor
# Railway: in the API service, reference the Postgres addon as ${{Postgres.DATABASE_URL}}
#          Migrations run from your laptop must use the PUBLIC proxy URL —
#          the *.railway.internal host only resolves inside Railway's network.
DATABASE_URL=

# Port the HTTP + Socket.io server binds to. Railway injects this automatically.
PORT=4000

# Comma-separated browser origins allowed to call the REST API and open a socket.
# Include every Vercel domain you need, e.g.
# http://localhost:3000,https://activity-monitor.vercel.app
CORS_ORIGIN=http://localhost:3000
