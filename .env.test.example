# Integration tests need their own database. They truncate the events table
# between tests, so pointing this at a database you care about will delete data.
#
# Copy to .env.test and set a connection string. Any PostgreSQL will do — a local
# instance, a Docker container, or a second database on your hosted provider:
#
#   createdb activity_monitor_test
#
# Then apply the schema to it:
#
#   npm run migrate:test
#
# If this file is absent, unit tests still run and the integration suites skip
# with a message rather than failing.
DATABASE_URL="postgresql://user:password@localhost:5432/activity_monitor_test?sslmode=disable"
